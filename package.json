{
  "name": "disparador-afiliados",
  "version": "0.1.0",
  "private": true,
  "description": "Disparo manual e agendado de links de afiliado Shopee e Mercado Livre para grupos de WhatsApp via ZapsterAPI",
  "type": "module",
  "engines": { "node": ">=22.18" },
  "scripts": {
    "start": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning src/server.ts",
    "dev": "node --env-file-if-exists=.env --no-warnings=ExperimentalWarning --watch src/server.ts",
    "test": "node --no-warnings=ExperimentalWarning --test test/*.test.ts"
  },
  "dependencies": {
    "@fastify/static": "^8.2.0",
    "fastify": "^5.6.1",
    "node-cron": "^4.2.1",
    "zod": "^4.1.12"
  }
}

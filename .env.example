# Copie para .env e preencha. Nunca faça commit do .env.

# Servidor
PORT=3000
# Usuário e senha do painel (Basic Auth). Deixe vazio só em uso local.
PANEL_USER=admin
PANEL_PASSWORD=
TZ=America/Sao_Paulo
DB_PATH=./data/disparador.db

# ZapsterAPI (https://app.zapsterapi.com/tokens)
ZAPSTER_TOKEN=
ZAPSTER_INSTANCE_ID=
ZAPSTER_BASE_URL=https://api.zapsterapi.com/v1
# Pausa entre envios para grupos diferentes (evita parecer spam no WhatsApp)
SEND_DELAY_MS=4000
# Segredo opcional para validar o webhook da Zapster (?secret=...)
ZAPSTER_WEBHOOK_SECRET=

# Shopee Affiliate Open API (painel de afiliados > Open API)
SHOPEE_APP_ID=
SHOPEE_SECRET=
SHOPEE_ENDPOINT=https://open-api.affiliate.shopee.com.br/graphql

# Mercado Livre (não há API pública de links de afiliado)
# Etiqueta do seu link builder, ex.: matt:SEUUSUARIO:TOOLID  (ou matt_word/matt_tool separados)
ML_MATT_WORD=
ML_MATT_TOOL=
# Opcional: token OAuth do developers.mercadolivre.com.br para buscar título/preço do anúncio
ML_ACCESS_TOKEN=
